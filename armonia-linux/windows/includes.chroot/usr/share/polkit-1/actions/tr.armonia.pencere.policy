<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Armonia "Windows programlari" ayar araci: dar yetkili root yardimcisi (pencere-yardimci). Yalniz etkin
     yerel oturum, parolasiz: kullanicinin parolasi yok; yardimci yalniz dogrulanmis alt komutlari calistirir.
     tr.armonia.ayar.policy ile ayni desen. Claude, 2026-11-25. -->
<policyconfig>
  <vendor>Armonia</vendor>
  <action id="tr.armonia.pencere">
    <description>Armonia Windows program tanimlarini degistir</description>
    <message>Windows programi eklemek/kaldirmak icin yetki gerekiyor</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/armonia/bin/pencere-yardimci</annotate>
  </action>
</policyconfig>
