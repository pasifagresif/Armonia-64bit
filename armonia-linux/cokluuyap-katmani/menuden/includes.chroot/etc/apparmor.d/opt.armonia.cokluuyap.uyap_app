# AppArmor profili: /opt/armonia/cokluuyap/uyap_app (Coklu UYAP, menuden acilan masaustu uygulamasi).
# Kaynak: eski kiosk profili (14.11; Gemini taslagi -> Claude -> guvenlik-denetci), 23.11 menuden duzenine uyarlandi.
# Asama 1: complain (ALLOWED kayitlari toplanir) -> daraltma -> enforce (G7). Claude, 2026-11-23.
# Calisma baglami: armonia-cokluuyap.service (User=armonia, HOME=~/.local/share/armonia-cokluuyap, kum havuzu).

abi <abi/4.0>,

include <tunables/global>


profile uyap_app /opt/armonia/cokluuyap/uyap_app flags=(attach_disconnected, complain) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/fonts>
  include <abstractions/ssl_certs>
  include if exists <abstractions/wayland>
  include if exists <abstractions/dri-common>
  include if exists <abstractions/dri-enumerate>
  include if exists <abstractions/mesa>

  # Uygulama ikilisi ve salt okunur kaynaklar (webapp/, enjekte/, models/, ice_servers.json)
  /opt/armonia/cokluuyap/uyap_app mr,
  /opt/armonia/cokluuyap/ r,
  /opt/armonia/cokluuyap/** r,

  # Veri klasoru (HOME, UYAP_DATA_DIR): static_cache, accounts.json, zs.sqlite3(-wal/-shm), zs_files/, config/
  owner /home/*/.local/share/armonia-cokluuyap/ r,
  owner /home/*/.local/share/armonia-cokluuyap/** rwk,
  # Toplu evrak (UYAP_EVRAK_KLASORU); tarayici bu klasoru salt okunur gorur (UYAP'a yukleme)
  owner /home/*/Belgeler/UYAP/ r,
  owner /home/*/Belgeler/UYAP/** rwk,
  # (O3) yazilabilir yolda 'm' yok: Mesa/fontconfig onbellegi de 'rwk' (calistirilabilir esleme yok)
  # (O1) UDF->PDF, imzalama, PTT gecici dosyalari; PrivateTmp ile servise ozel /tmp
  owner /tmp/** rwk,
  # Ev dizininin geri kalani birimde zaten gorunmez (ProtectHome=tmpfs); profil de yazmayi yasaklar
  deny /home/*/.config/** wl,
  deny /home/*/.local/share/armonia-tarayici/** rwl,

  # Wayland ve XDG_RUNTIME_DIR (wl_shm / memfd tamponlari)
  owner /run/user/[0-9]*/ r,
  owner /run/user/[0-9]*/wayland-[0-9]* rw,
  # (K1) systemd --user / D-Bus soketleri yasak: StartTransientUnit ile exec yasagi asilabilirdi
  deny /run/user/*/{bus,systemd/**} rw,
  owner /dev/shm/** rwk,

  # GPU / Mesa (llvmpipe veya donanim)
  /dev/dri/ r,
  /dev/dri/card[0-9]* rw,
  /dev/dri/renderD[0-9]* rw,
  /sys/devices/pci[0-9]*/** r,
  /sys/devices/platform/** r,
  /sys/devices/virtual/** r,
  /sys/class/drm/ r,
  /sys/class/drm/** r,
  /sys/bus/pci/devices/ r,
  /usr/lib/*-linux-gnu/dri/ r,
  /usr/lib/*-linux-gnu/dri/** mr,
  /usr/lib/*-linux-gnu/gbm/** mr,
  /usr/share/glvnd/** r,
  /etc/glvnd/** r,
  # Mesa dmabuf (Hyper-V complain kaydi, 04:52)
  /dev/udmabuf rw,
  /usr/share/egl/** r,
  /usr/share/drirc.d/** r,
  /usr/share/libdrm/** r,

  # Klavye, imlec temalari, compose
  /usr/share/X11/xkb/** r,
  /usr/share/X11/locale/** r,
  /usr/share/icons/** r,

  # Ag: HTTPS istemci, 8800/8843 dinleme, UDP 4430 kesif, netlink (arayuz listesi). Port kisiti nftables'ta.
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,
  network unix stream,
  network unix dgram,
  /etc/resolv.conf r,
  /run/systemd/resolve/** r,
  /etc/gai.conf r,
  /etc/ssl/certs/** r,
  /usr/share/ca-certificates/** r,

  # PostgreSQL Unix soketi: 23.11 karari "simdilik yok" -> kapali (soket birimde de InaccessiblePaths)
  deny /run/postgresql/** rw,

  # Akilli kart: dogrudan YOK; e-imza yalniz 127.0.0.1:5975 uzerinden (pcscd polkit ile yalniz eimza)
  # /run/pcscd/pcscd.comm rw,
  # /usr/lib/*-linux-gnu/libakisp11.so mr,

  # Surec bilgisi, cgroup (tokio cekirdek sayisi), zaman, yerel ayar
  owner @{PROC}/@{pid}/{stat,status,maps,cgroup,mountinfo,comm} r,
  owner @{PROC}/@{pid}/fd/ r,
  owner @{PROC}/@{pid}/task/** r,
  owner @{PROC}/@{pid}/task/@{tid}/comm rw,
  @{PROC}/sys/kernel/random/uuid r,
  /sys/fs/cgroup/** r,
  /sys/devices/system/cpu/** r,
  /etc/localtime r,
  /usr/share/zoneinfo/** r,
  /usr/share/locale/** r,
  /usr/lib/locale/** mr,

  # "Tarayiciyi Ac": xdg-open (sh) adresi denetleyip nc ile armonia-tarayici.sock soketine yazar. Chromium bu
  # profilde CALISMAZ; root systemd soket etkinlestirmesiyle ayri birimde (armonia-tarayici@.service) baslar.
  /usr/local/bin/xdg-open rix,
  /usr/bin/dash rix,
  /usr/bin/nc.openbsd rix,
  /run/armonia-tarayici.sock rw,

  # Acik yasaklar (exec enforce'ta varsayilan inkar; complain kipinde serbest ama gunluge dusuyor)
  # winit'in pencere susu kutuphanesi (sctk-adwaita) karanlik tema icin dbus-send, baslik yazi tipi icin fc-match
  # calistiriyor (complain kaydi 04:52); ikisi de istege bagli, basarisizsa varsayilana duser -> sessizce yasak
  deny /usr/bin/dbus-send x,
  deny /usr/bin/fc-match x,
  deny ptrace,
  deny mount,
  deny umount,
  deny pivot_root,
  # (yalniz inet: "network raw" netlink raw'i da yasaklar ve deny her zaman kazanir)
  deny network inet raw,
  deny network inet6 raw,
  deny network packet,
  deny capability,
}
