// Armonia: masaustu kullanicisi ('armonia') YALNIZ armonia-cokluuyap.service birimini baslatip durdurabilir
// (menu kisayolu). Baska birim, baska fiil (enable, mask, ...) ya da uzak/etkin olmayan oturum bu kurala uymaz ve
// varsayilan polkit kararina (yonetici parolasi) duser. Claude, 2026-11-23.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "armonia-cokluuyap.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
        subject.user == "armonia" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
