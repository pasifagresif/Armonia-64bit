/* Armonia ust cubuk. tema-yardimci uretir (sablon: /etc/armonia/tema/ust.css.sablon); elle degistirmeyin. */
* { font-family: "DejaVu Sans", sans-serif; font-size: 13px; min-height: 0; }
window#waybar { background: alpha(#@ZEMIN@, 0.96); color: #@YAZI@; border: 1px solid #@KENAR@; border-radius: 14px; }
#custom-logo {
  font-size: 17px; font-weight: bold; color: #@YAZI@;
  background-image: url("/usr/share/armonia/simge/@LOGO@.png"); background-repeat: no-repeat; background-size: 24px 24px;
  background-position: 10px center; padding: 0 12px 0 40px;
}
#custom-kip.canli { color: #@VURGU_UZERI@; background: #@VURGU@; border-radius: 9px; margin: 7px 0; padding: 0 10px; }
#clock { font-size: 14px; }
#memory, #custom-klavye, #custom-eimza { background: #@HAP@; border-radius: 9px; margin: 7px 0; padding: 0 10px; }
#custom-eimza.hazir { color: #@VURGU_UZERI@; background: #@VURGU@; }
#custom-eimza.kapali { color: #FAF8F4; background: #A0522D; }
#memory.uyari { color: #A0522D; }
#memory.kritik { color: #FAF8F4; background: #A0522D; }
#network, #wireplumber, #battery, #custom-guc {
  background-repeat: no-repeat; background-size: 20px 20px; background-position: left center;
  margin: 7px 2px; padding: 0 4px 0 24px; border-radius: 6px;
}
#network.ethernet { background-image: url("/usr/share/armonia/simge/kablo.png"); }
#network.wifi, #network.linked { background-image: url("/usr/share/armonia/simge/wifi.png"); }
#network.disconnected { color: #A0522D; padding-left: 4px; }
#wireplumber { background-image: url("/usr/share/armonia/simge/ses.png"); }
#battery { background-image: url("/usr/share/armonia/simge/pil.png"); }
#battery.uyari { color: #A0522D; }
#battery.kritik { color: #FAF8F4; background-color: #A0522D; }
#custom-guc { background-image: url("/usr/share/armonia/simge/guc.png"); margin-right: 10px; padding-left: 20px; }
#custom-logo:hover, #custom-guc:hover, #wireplumber:hover { background-color: #@HAP@; }
tooltip { background: #@ZEMIN@; border: 1px solid #@VURGU@; border-radius: 8px; }
tooltip label { color: #@YAZI@; }
