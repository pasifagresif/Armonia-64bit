# Armonia "A" menusu (fuzzel). tema-yardimci uretir (sablon: /etc/armonia/tema/fuzzel.ini.sablon); elle degistirmeyin.
# 1.8 bilinmeyen anahtarda (anchor, colors.prompt) hic acilmiyor (Pi onizlemesi).
[main]
font=DejaVu Sans:size=12
prompt="Ara  "
icon-theme=Adwaita
terminal=/bin/false
layer=overlay
width=36
lines=12
horizontal-pad=16
vertical-pad=12
inner-pad=8
line-height=28
show-actions=no

[colors]
background=@ZEMIN@f2
text=@YAZI@ff
match=@VURGU_KOYU@ff
selection=@VURGU@ff
selection-text=@VURGU_UZERI@ff
selection-match=@VURGU_UZERI@ff
border=@VURGU_KOYU@ff

[border]
width=2
radius=12
