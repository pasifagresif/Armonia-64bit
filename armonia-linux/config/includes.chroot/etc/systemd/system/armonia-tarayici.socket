# Armonia: masaustunun tarayici acma istegi (xdg-open, tek satir URL). Her baglanti icin bir
# armonia-tarayici@.service ornegi baslar. Yalniz 'armonia' kullanicisi yazabilir. Claude, 2026-11-14 / 11-19.
[Unit]
Description=Armonia tarayici istek soketi

[Socket]
ListenStream=/run/armonia-tarayici.sock
SocketUser=armonia
SocketGroup=armonia
SocketMode=0600
Accept=yes
# Ard arda tiklamada servis firtinasi olmasin
MaxConnections=4
MaxConnectionsPerSource=2
# Tetik siniri asilinca soket kalici "failed" olmasin diye genis pencere (guvenlik-denetci D3)
TriggerLimitIntervalSec=10s
TriggerLimitBurst=20

[Install]
WantedBy=sockets.target
