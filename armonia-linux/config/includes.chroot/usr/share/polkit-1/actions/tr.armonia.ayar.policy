<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Armonia Ayarlar: dar yetkili root yardimcisi (ayar-yardimci). Yalniz etkin yerel oturum, parolasiz:
     kullanicinin parolasi yok; yardimci yalniz dogrulanmis alt komutlari calistirir. Claude, 2026-11-19. -->
<policyconfig>
  <vendor>Armonia</vendor>
  <action id="tr.armonia.ayar">
    <description>Armonia sistem ayarlarini degistir</description>
    <message>Sistem ayarini degistirmek icin yetki gerekiyor</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/armonia/bin/ayar-yardimci</annotate>
  </action>
</policyconfig>
