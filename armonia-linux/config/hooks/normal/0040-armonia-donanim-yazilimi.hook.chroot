#!/bin/sh
# ISO: en sik donanim yazilimlari (firmware) ve islemci mikrokodu (kullanici karari 23.11). Debian 'main' bunlari
# icermez; Wi-Fi karti yazilimi olmayan dizustunde ag hic yoktur ve yazilim sonradan da indirilemez.
# live-build'in "butun firmware paketleri" ozelligi KAPALI (--firmware-chroot false): yalniz bu liste girer.
# Yazilim dosyalari yalniz ilgili aygit takiliysa, surucusu tarafindan yuklenir; calisan sistemi yavaslatmaz.
# Pi imaji bu kancayi kullanmaz (Raspberry Pi OS kendi yazilimlariyla gelir). Claude, 2026-11-23.
set -eu
# Zorunlu: Wi-Fi (Intel, Realtek, Qualcomm Atheros, Broadcom), AMD ekran karti, Intel dizustu sesi (SOF), mikrokod
ZORUNLU="firmware-linux-free firmware-iwlwifi firmware-realtek firmware-atheros firmware-brcm80211 \
firmware-amd-graphics firmware-sof-signed intel-microcode amd64-microcode"
# Istege bagli (paket adi Debian surumune gore degisebilir): yeni Intel ekran karti, MediaTek Wi-Fi
ISTEGE="firmware-intel-graphics firmware-mediatek"
export DEBIAN_FRONTEND=noninteractive
apt-get install -y -q --no-install-recommends $ZORUNLU
for p in $ISTEGE; do
  apt-get install -y -q --no-install-recommends "$p" || echo "UYARI: $p kurulamadi (bu Debian surumunde yok olabilir)"
done
for p in $ZORUNLU; do dpkg -s "$p" >/dev/null 2>&1 || { echo "HATA: $p kurulmadi"; exit 1; }; done
echo "Donanim yazilimlari: $(du -sh /usr/lib/firmware 2>/dev/null | cut -f1)"
