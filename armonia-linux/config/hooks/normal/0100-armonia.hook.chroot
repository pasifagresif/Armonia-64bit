#!/bin/sh
# Armonia chroot ayarlari: masaustu kullanicisi, servisler, gereksiz zamanlayicilar. Claude, 2026-11-13.
# 2026-11-19: kiosk (uyap_app acilista) -> temel masaustu. Coklu UYAP, kasa ve PostgreSQL bu imajda YOK.
set -e
# Canli sistemin masaustu kullanicisi: parolasiz (kilitli; greetd otomatik giris), sudo yok, ek grup yok
# (ekran/ses/giris aygitlarina erisim logind oturumundan gelir). Kurulu sistemde Calamares kendi kullanicisini acar (A6).
useradd --create-home --home-dir /home/armonia --shell /bin/bash --comment "Armonia" armonia
passwd -l armonia
chmod 0700 /home/armonia
# Belgeler / Indirilenler (xdg-user-dirs Turkce adlar) ve tarayici profili: tarayici birimi bunlari baglar
for d in .config .local .local/share .local/share/armonia-tarayici Belgeler İndirilenler; do
  install -d -o armonia -g armonia -m 0700 "/home/armonia/$d"
done
printf 'XDG_DOCUMENTS_DIR="$HOME/Belgeler"\nXDG_DOWNLOAD_DIR="$HOME/İndirilenler"\n' > /home/armonia/.config/user-dirs.dirs
chown armonia:armonia /home/armonia/.config/user-dirs.dirs
# Turkce yerel ayar (saat/tarih, LibreOffice, menuler)
sed -i 's/^# *tr_TR.UTF-8 UTF-8/tr_TR.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
printf 'LANG=tr_TR.UTF-8\n' > /etc/default/locale
printf 'LANG=tr_TR.UTF-8\n' > /etc/locale.conf
# Masaustu ayarlari root'a ait, kullanici degistiremez (/etc/armonia: labwc, waybar, fuzzel, mako)
chown -R root:root /opt/armonia /etc/armonia
chmod 0755 /opt/armonia/bin/*.sh
chmod -R go-w /opt/armonia /etc/armonia /etc/systemd/system/armonia-*.service /etc/NetworkManager/conf.d
chmod 0755 /opt/armonia/bin/ayar-yardimci
# Denetim: kok dosya sisteminde herkese-yazilabilir dosya kalmasin (sticky /tmp haric)
if find / -xdev -type f -perm -0002 2>/dev/null | grep -q .; then
  echo "UYARI: herkese-yazilabilir dosyalar:"; find / -xdev -type f -perm -0002 2>/dev/null | head
fi
ln -sf /usr/share/zoneinfo/Europe/Istanbul /etc/localtime
printf '127.0.0.1 localhost\n127.0.1.1 armonia\n' > /etc/hosts
systemctl set-default graphical.target
systemctl enable greetd.service NetworkManager.service systemd-resolved.service nftables.service
# Ag yonetimi NetworkManager'da (19.11); networkd ayni arayuzu yonetmesin
systemctl disable systemd-networkd.service systemd-networkd.socket 2>/dev/null || true
systemctl mask NetworkManager-wait-online.service
# armonia-olcum yalniz olcum ISO'sunda calisir (ConditionKernelCommandLine)
systemctl enable armonia-olcum.service
# Tarayici istek soketi (Chromium masaustu oturumunun disinda, kendi kum havuzunda) ve USB aygit politikasi
systemctl enable armonia-tarayici.socket usbguard.service armonia-usb-sor.service
# ipp-usb paket bagimliligi avahi-daemon'u getirir: yazicilar agda duyurulmaz, mDNS kapisi acilmaz
systemctl mask avahi-daemon.service avahi-daemon.socket
grep -q '^  dns-sd = disable' /etc/ipp-usb/ipp-usb.conf || { echo "HATA: ipp-usb ayari Armonia surumu degil"; exit 1; }
# trixie'de usbguard-dbus ayni pakette ve kendini etkinlestiriyor: D-Bus/Polkit uzerinden kural degistirme yuzeyi
# (Gemini taslagi da kurulmamasini istiyordu). Yonetim yalniz root CLI ile (A5'te "takinca sor" yardimcisi).
systemctl mask usbguard-dbus.service
# guvenlik-denetci Y2: tarayici birimi kullanicinin systemd --user / D-Bus soketlerine erisemesin
# (StartTransientUnit ile kum havuzu disinda komut). %U system biriminde 0'a cozulur -> UID burada yazilir.
U=$(id -u armonia); install -d -m 0755 /etc/systemd/system/armonia-tarayici@.service.d
printf '# Hook uretti (armonia UID=%s). guvenlik-denetci Y2/EK-Y1: /run/user tmpfs icine yalniz bu soketler.\n[Service]\nBindPaths=/run/user/%s/wayland-0 -/run/user/%s/pulse/native -/run/user/%s/pipewire-0\n' \
  "$U" "$U" "$U" "$U" > /etc/systemd/system/armonia-tarayici@.service.d/20-calisma.conf
# Chromium'un kendi menu girisi gizli (/usr/local/share/applications/chromium.desktop); varsayilan tarayici
# armonia-tarayici.desktop (/etc/xdg/mimeapps.list)
# E-imza (Adalet E-imza, config/packages.chroot/adalet-eimza-tray_*.deb): ayri sistem kullanicisi, gruplarsiz
if [ -x /usr/lib/adalet-eimza-tray/bin/adalet-eimza-tray ]; then
  useradd --system --no-create-home --home-dir /var/lib/armonia-eimza --shell /usr/sbin/nologin eimza
  # Paketin kendi --user birimi (tepsi, X11) ve apt deposu kullanilmaz; guncelleme yeni ISO ile gelir
  rm -f /usr/lib/systemd/user/adalet-eimza-tray.service /etc/apt/sources.list.d/adalet-eimza-tray.sources \
        /etc/apt/trusted.gpg.d/adalet-eimza-tray.asc /usr/share/applications/tr.gov.adalet.eimza-tray.desktop
  chmod 0644 /etc/polkit-1/rules.d/50-armonia-eimza.rules
  systemctl enable armonia-eimza.service pcscd.socket
  # E-O4: paketin apt deposu / --user birimi imajda kalmamali
  if ls /etc/apt/sources.list.d/ /usr/lib/systemd/user/ | grep -qi eimza; then echo "HATA: e-imza deposu/birimi kaldi"; exit 1; fi
elif [ "${ARMONIA_PI:-0}" = "1" ]; then
  # Raspberry Pi deneme imaji (arm64): resmi paket yalniz amd64 -> pi_derle.sh jar'i /opt/armonia/eimza'ya koyar,
  # birim Debian OpenJDK 21 ile calisir (armonia-eimza.service.d/50-pi.conf). 2026-11-20.
  [ -f /opt/armonia/eimza/eimza-tray.jar ] && [ -x /usr/lib/jvm/java-21-openjdk-arm64/bin/java ] \
    || { echo "HATA: Pi e-imza jar'i ya da OpenJDK 21 yok"; exit 1; }
  useradd --system --no-create-home --home-dir /var/lib/armonia-eimza --shell /usr/sbin/nologin eimza
  chmod 0644 /etc/polkit-1/rules.d/50-armonia-eimza.rules
  systemctl enable armonia-eimza.service pcscd.socket
else
  echo "HATA: adalet-eimza-tray kurulmamis"; exit 1
fi
# Ses: PipeWire kullanicinin oturumunda (paket on ayari zaten acar; acikca garanti edilir)
systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service
# USBGuard: kurallar ve ayar yalniz root'a (paket postinst'in urettigi kural dosyasi imajdakiyle degisir)
if [ -d /etc/usbguard ]; then
  chown -R root:root /etc/usbguard; chmod 0700 /etc/usbguard
  chmod 0600 /etc/usbguard/usbguard-daemon.conf /etc/usbguard/rules.conf
  install -d -m 0700 /etc/usbguard/IPCAccessControl.d /var/log/usbguard
  grep -q '^# Armonia kurallari sonu$' /etc/usbguard/rules.conf && grep -q '^# Armonia USBGuard servis ayari' /etc/usbguard/usbguard-daemon.conf \
    || { echo "HATA: usbguard ayarlari Armonia surumu degil (paket uzerine yazmis olabilir)"; exit 1; }
fi
# Oturum kum havuzunda degil (denetci 19.11 Y1): komut calistirma kapilari kapatilir.
# Thunar "Ozel Eylemler" (uca) eklentisi her komutu calistirabilir -> kaldirilir.
rm -f /usr/lib/*/thunarx-3/thunar-uca.so
# LibreOffice makrolari kapali ve kilitli: /usr/lib/libreoffice/share/registry/armonia.xcd (includes.chroot)
[ -f /usr/lib/libreoffice/share/registry/armonia.xcd ] || { echo "HATA: LibreOffice makro kilidi yok"; exit 1; }
# greetd: paket kendi config.toml'unu (vt7, /bin/sh) yazmis olabilir; Armonia surumu olmali
grep -q '^# Armonia giris yoneticisi' /etc/greetd/config.toml \
  || { echo "HATA: /etc/greetd/config.toml Armonia surumu degil"; exit 1; }
# live-config gerekmiyor; fail-safe girdisiyle varsayilan "user"/sudo olusturabiliyordu (guvenlik-denetci Y1)
apt-get purge -y live-config live-config-systemd || true
# Acilisi yavaslatan / gereksiz birimler. getty@tty1: greetd vt1'de. (Kurulu sistemde guvenlik guncellemesi
# icin apt zamanlayicilari A6'da yeniden acilir.)
systemctl mask apt-daily.timer apt-daily-upgrade.timer man-db.timer e2scrub_all.timer \
  e2scrub_reap.service fstrim.timer dpkg-db-backup.timer systemd-networkd-wait-online.service \
  getty@tty1.service live-config.service networking.service
# Faz 2 kasa: wall ajani ExecStartPre'de Plymouth parola ajanini durduruyor; crypttab 'nofail' oldugundan
# acilis kasayi beklemeden ilerleyince yanlis paroladan sonra parola bir daha sorulmuyordu (Hyper-V 3. deneme).
systemctl mask systemd-ask-password-wall.path systemd-ask-password-wall.service
# AppArmor: uyap_app profili Coklu UYAP katmaniyla gelecek. Imajda olmayan programlarin ~100 profili (firefox,
# chrome, lxc, sbuild...) acilista bosuna derlenmesin: yalniz dosyalar silinir (abstractions/, tunables/, abi/ kalir)
find /etc/apparmor.d -maxdepth 1 -type f ! -name 'opt.armonia.*' -delete
# PostgreSQL: Coklu UYAP katmaniyla gelecek (kasa/). Bu imajda paket yok.
# Faz 2: Armonia Plymouth temasi (kasa parolasi ekrani); initramfs yeniden uretilir
if [ -f /usr/share/plymouth/themes/armonia/armonia.plymouth ] && command -v plymouth-set-default-theme >/dev/null; then
  plymouth-set-default-theme -R armonia
fi
